        "message": "=<div style=\"font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; direction: rtl; text-align: right; background-color: #f4f7f6; padding: 30px; color: #2c3e50;\">\n  \n  <div style=\"max-width: 650px; margin: 0 auto; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.05);\">\n    \n    <!-- Header -->\n    <div style=\"background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); padding: 30px; text-align: center; color: #ffffff;\">\n      <h1 style=\"margin: 0; font-size: 24px; font-weight: 700; letter-spacing: 0.5px;\">🎓 EduPath AI</h1>\n      <p style=\"margin: 8px 0 0 0; font-size: 14px; opacity: 0.9;\">مسارك التعليمي المخصص وتوصيات الكورسات</p>\n    </div>\n\n    <!-- Body Content -->\n    <div style=\"padding: 30px; line-height: 1.8;\">\n      \n      <!-- Greeting Card -->\n      <div style=\"background-color: #eef2f7; border-right: 4px solid #2a5298; padding: 15px 20px; border-radius: 6px; margin-bottom: 25px;\">\n        <h3 style=\"margin: 0; color: #1e3c72; font-size: 18px;\">أهلاً بك يا {{ $('On form submission').first().json[\"Full Name\"] }} 👋</h3>\n        <p style=\"margin: 5px 0 0 0; font-size: 14px; color: #555;\">يسعدنا أن نكون جزءاً من رحلتك التعليمية لتطوير مهاراتك في مجالات الذكاء الاصطناعي والأتمتة.</p>\n      </div>\n\n      <!-- Cleaned AI Report Container -->\n      <div style=\"background-color: #ffffff; border: 1px solid #e1e8ed; border-radius: 8px; padding: 20px; margin-bottom: 25px; font-size: 14px; color: #34495e; line-height: 1.8;\">\n{{ \n  $json.content.parts[0].text\n    .replace(/\\*\\*/g, '')\n    .replace(/###/g, '')\n    .replace(/---/g, '')\n    .replace(/\\n/g, '<br>') \n}}\n      </div>\n\n      <!-- WhatsApp Action Button -->\n      <div style=\"text-align: center; margin: 30px 0 15px 0;\">\n        <a href=\"https://wa.me/201029492773\" style=\"background-color: #25d366; color: #ffffff; padding: 12px 28px; text-decoration: none; border-radius